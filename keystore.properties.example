# Google Play UPLOAD key configuration for the `release` signingConfig.
#
# Copy this file to `keystore.properties` (which is gitignored — NEVER commit it
# or the .jks) and fill in the real values. The release build (bundlePlayRelease)
# is left UNSIGNED if this file is absent, so CI/local can still assemble.
#
# Generate an upload key once (keep the .jks + passwords backed up safely; if you
# lose them you must contact Google Play support to reset the upload key):
#
#   keytool -genkeypair -v -keystore humanos-upload.jks \
#     -alias humanos-upload -keyalg RSA -keysize 2048 -validity 9125
#
# storeFile may be an absolute path or relative to the repo root.

storeFile=humanos-upload.jks
storePassword=CHANGE_ME
keyAlias=humanos-upload
keyPassword=CHANGE_ME
